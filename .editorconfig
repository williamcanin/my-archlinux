# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 80

[*.{md,markdown}]
max_line_length = 100

[LICENSE]
indent_style = tab
indent_size = 4

[*.sh]
max_line_length = 90

[*.py]
indent_size = 4
